// 1. Los seis operadores relacionales
2A < 10
A + B <= 6.5
3A - 2B > 6
2(B + 1) >= 7
4B == 10
C != 3

// 2. Precedencia completa: unario -> *,/,impl -> +,- -> rel -> not -> and -> or
